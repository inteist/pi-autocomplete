{
  "name": "pi-autocomplete",
  "version": "0.1.0",
  "description": "Local Ollama autocomplete wrapper for Pi prompt editors, compatible with pi-vim/pi-vim-mode.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "vim",
    "autocomplete",
    "inline-completion",
    "ollama"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "echo 'nothing to build'",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .tmp/test-dist && tsc -p tsconfig.test.json && node --test .tmp/test-dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@earendil-works/pi-tui": "^0.78.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
